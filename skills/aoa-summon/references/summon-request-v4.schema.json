{
  "$defs": {
    "actorMandateRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-agents"
            },
            "schema_version": {
              "const": "actor-mandate-v1"
            }
          }
        }
      ]
    },
    "agentObligationRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-agents"
            },
            "schema_version": {
              "const": "agent-obligation-v1"
            }
          }
        }
      ]
    },
    "contentRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "type": "string"
        },
        "owner_repo": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "owner_repo",
        "schema_version",
        "digest"
      ],
      "type": "object"
    },
    "incarnationBindingRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-sdk"
            },
            "schema_version": {
              "const": "aoa_agent_incarnation_binding_v2"
            }
          }
        }
      ]
    },
    "modelFitProjectionRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-models"
            },
            "schema_version": {
              "const": "aoa_model_fit_projection_v1"
            }
          }
        }
      ]
    },
    "modelFitQueryResultRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-models"
            },
            "schema_version": {
              "const": "aoa_model_fit_query_result_v2"
            }
          }
        }
      ]
    },
    "modelRealizationRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-models"
            },
            "schema_version": {
              "const": "aoa_model_realization_v1"
            }
          }
        }
      ]
    },
    "responsibilityClassificationRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-agents"
            },
            "schema_version": {
              "const": "responsibility-classification-v1"
            }
          }
        }
      ]
    },
    "responsibilityTransferAdmissionRef": {
      "additionalProperties": false,
      "properties": {
        "admitted_state": {
          "enum": [
            "accepted",
            "narrowed",
            "launched"
          ]
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "holder_ids": {
          "description": "Ordered previous and current responsibility holders.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "type": "array",
          "uniqueItems": true
        },
        "object_id": {
          "minLength": 1,
          "type": "string"
        },
        "owner_repo": {
          "const": "aoa-agents"
        },
        "schema_version": {
          "const": "responsibility-transfer-v1"
        }
      },
      "required": [
        "object_id",
        "owner_repo",
        "schema_version",
        "digest",
        "admitted_state",
        "holder_ids"
      ],
      "type": "object"
    },
    "roleResolutionRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-agents"
            },
            "schema_version": {
              "const": "aoa_role_resolution_v1"
            }
          }
        }
      ]
    },
    "runPlanRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-sdk"
            },
            "schema_version": {
              "const": "aoa_control_plane_v1"
            }
          }
        }
      ]
    },
    "runtimeEventRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "abyss-stack"
            },
            "schema_version": {
              "const": "abyss_stack_external_codex_event_v1"
            }
          }
        }
      ]
    },
    "runtimeLaunchRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "abyss-stack"
            },
            "schema_version": {
              "const": "abyss_stack_external_codex_launch_v1"
            }
          }
        }
      ]
    },
    "sdkContinuityRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-sdk"
            }
          }
        }
      ]
    },
    "sdkSummonDecisionRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-sdk"
            },
            "schema_version": {
              "const": "urn:aoa-sdk:a2a:summon-result:v4"
            }
          }
        }
      ]
    },
    "sdkSummonRequestRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-sdk"
            },
            "schema_version": {
              "const": "urn:aoa-sdk:a2a:summon-request:v4"
            }
          }
        }
      ]
    },
    "taskLocalDagRef": {
      "allOf": [
        {
          "$ref": "#/$defs/contentRef"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "aoa-skills"
            },
            "schema_version": {
              "const": "aoa-task-local-dag-v2"
            }
          }
        }
      ]
    }
  },
  "$id": "https://example.invalid/aoa-summon/request-v4.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "quest_passport": {
              "properties": {
                "route_anchor": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "route_anchor"
              ]
            }
          }
        },
        {
          "properties": {
            "summon_request": {
              "properties": {
                "parent_task_id": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "parent_task_id"
              ]
            }
          }
        },
        {
          "properties": {
            "summon_request": {
              "properties": {
                "session_ref": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "session_ref"
              ]
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "summon_request": {
            "properties": {
              "transport_preference": {
                "const": "external_cli"
              }
            },
            "required": [
              "transport_preference"
            ]
          }
        },
        "required": [
          "summon_request"
        ]
      },
      "then": {
        "properties": {
          "external_incarnation": {
            "properties": {
              "launches_separate_os_process": {
                "const": true
              },
              "separate_cli_session": {
                "const": true
              },
              "usage_metering": {
                "const": "observe_only_no_budget"
              },
              "uses_builtin_codex_subagents": {
                "const": false
              }
            }
          }
        },
        "required": [
          "external_incarnation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "summon_request": {
            "properties": {
              "transport_preference": {
                "enum": [
                  "codex_local",
                  "either"
                ]
              }
            },
            "required": [
              "transport_preference"
            ]
          }
        },
        "required": [
          "summon_request"
        ]
      },
      "then": {
        "properties": {
          "responsibility_classification": {
            "properties": {
              "disposition": {
                "const": "not_independent"
              }
            }
          }
        },
        "required": [
          "responsibility_classification"
        ]
      }
    }
  ],
  "properties": {
    "audit_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "checkpoint_note_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "child_inputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "artifact",
              "context",
              "contract",
              "evidence",
              "source",
              "other"
            ],
            "type": "string"
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "child_scope": {
      "additionalProperties": false,
      "properties": {
        "allowed_effects": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "allowed_tools": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "authority_limit": {
          "minLength": 1,
          "type": "string"
        },
        "task": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "task",
        "allowed_tools",
        "allowed_effects",
        "authority_limit"
      ],
      "type": "object"
    },
    "child_stop_line": {
      "minLength": 1,
      "type": "string"
    },
    "codex_trace_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_outputs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "external_incarnation": {
      "additionalProperties": false,
      "properties": {
        "actor_mandate_ref": {
          "$ref": "#/$defs/actorMandateRef"
        },
        "continuity_ref": {
          "$ref": "#/$defs/sdkContinuityRef"
        },
        "domain_procedure_refs": {
          "items": {
            "$ref": "#/$defs/contentRef"
          },
          "minItems": 1,
          "type": "array"
        },
        "incarnation_binding_ref": {
          "$ref": "#/$defs/incarnationBindingRef"
        },
        "launches_separate_os_process": {
          "type": "boolean"
        },
        "model_fit_projection_ref": {
          "$ref": "#/$defs/modelFitProjectionRef"
        },
        "model_fit_query_result_ref": {
          "$ref": "#/$defs/modelFitQueryResultRef"
        },
        "model_realization_ref": {
          "$ref": "#/$defs/modelRealizationRef"
        },
        "obligation_ref": {
          "$ref": "#/$defs/agentObligationRef"
        },
        "responsibility_transfer_ref": {
          "$ref": "#/$defs/responsibilityTransferAdmissionRef"
        },
        "return_event_schema_ref": {
          "$ref": "#/$defs/runtimeEventRef"
        },
        "role_resolution_ref": {
          "$ref": "#/$defs/roleResolutionRef"
        },
        "run_plan_ref": {
          "$ref": "#/$defs/runPlanRef"
        },
        "runtime_interface": {
          "minLength": 1,
          "type": "string"
        },
        "runtime_launch_ref": {
          "$ref": "#/$defs/runtimeLaunchRef"
        },
        "sdk_summon_decision_ref": {
          "$ref": "#/$defs/sdkSummonDecisionRef"
        },
        "sdk_summon_request_ref": {
          "$ref": "#/$defs/sdkSummonRequestRef"
        },
        "separate_cli_session": {
          "type": "boolean"
        },
        "task_local_dag_ref": {
          "$ref": "#/$defs/taskLocalDagRef"
        },
        "usage_metering": {
          "enum": [
            "observe_only_no_budget"
          ],
          "type": "string"
        },
        "uses_builtin_codex_subagents": {
          "type": "boolean"
        }
      },
      "required": [
        "obligation_ref",
        "actor_mandate_ref",
        "role_resolution_ref",
        "model_fit_query_result_ref",
        "model_fit_projection_ref",
        "model_realization_ref",
        "run_plan_ref",
        "task_local_dag_ref",
        "incarnation_binding_ref",
        "sdk_summon_request_ref",
        "sdk_summon_decision_ref",
        "runtime_launch_ref",
        "runtime_interface",
        "responsibility_transfer_ref",
        "domain_procedure_refs",
        "continuity_ref",
        "return_event_schema_ref",
        "launches_separate_os_process",
        "uses_builtin_codex_subagents",
        "separate_cli_session",
        "usage_metering"
      ],
      "type": "object"
    },
    "intent": {
      "enum": [
        "decide",
        "execute"
      ],
      "type": "string"
    },
    "progression_overlay_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "quest_passport": {
      "additionalProperties": true,
      "properties": {
        "control_mode": {
          "type": "string"
        },
        "delegate_tier": {
          "type": "string"
        },
        "difficulty": {
          "type": "string"
        },
        "expected_artifacts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fallback_tier": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk": {
          "type": "string"
        },
        "route_anchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "self_agent": {
          "type": "boolean"
        },
        "wrapper_class": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "difficulty",
        "risk",
        "control_mode",
        "delegate_tier"
      ],
      "type": "object"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "request_ref": {
      "minLength": 1,
      "type": "string"
    },
    "responsibility_classification": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "const": "not_independent",
          "type": "string"
        },
        "result_ref": {
          "$ref": "#/$defs/responsibilityClassificationRef"
        }
      },
      "required": [
        "disposition",
        "result_ref"
      ],
      "type": "object"
    },
    "return_owner": {
      "minLength": 1,
      "type": "string"
    },
    "reviewed_artifact_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "self_agent_checkpoint_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "stress_bundle_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "summon_request": {
      "additionalProperties": true,
      "not": {
        "required": [
          "expected_outputs"
        ]
      },
      "properties": {
        "child_agent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "desired_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "require_progression": {
          "type": "boolean"
        },
        "reviewed_artifact_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_preference": {
          "enum": [
            "codex_local",
            "a2a_remote",
            "external_cli",
            "either"
          ],
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "quest_passport",
    "summon_request",
    "expected_outputs",
    "intent",
    "return_owner",
    "child_scope",
    "child_stop_line",
    "child_inputs",
    "request_ref",
    "request_digest"
  ],
  "title": "aoa-summon request v4",
  "type": "object"
}
