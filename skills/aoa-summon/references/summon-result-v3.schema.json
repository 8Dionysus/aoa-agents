{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aoa-summon/result-v3.schema.json",
  "title": "aoa-summon result v3",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "allowed",
    "lane",
    "execution_surface",
    "cohort_pattern",
    "closeout_required",
    "decision_state",
    "binding",
    "runtime_state",
    "return_validation",
    "closeout_handoff",
    "actual_effects",
    "stop_line"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"lane": {"const": null}},
        "required": ["lane"]
      },
      "then": {
        "properties": {
          "allowed": {"const": false},
          "decision_state": {"const": "blocked"},
          "reason_codes": {
            "contains": {"const": "blocked_missing_request_input"}
          },
          "runtime_state": {
            "properties": {"state": {"const": "not_run"}},
            "required": ["state"]
          }
        },
        "required": ["reason_codes"]
      }
    },
    {
      "if": {
        "properties": {"allowed": {"const": true}},
        "required": ["allowed"]
      },
      "then": {
        "properties": {
          "decision_state": {"const": "allowed"},
          "lane": {
            "enum": [
              "codex_local_leaf",
              "codex_local_reviewed",
              "remote_reviewed"
            ]
          },
          "execution_surface": {"type": "string", "minLength": 1},
          "cohort_pattern": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"decision_state": {"const": "allowed"}},
        "required": ["decision_state"]
      },
      "then": {
        "properties": {"allowed": {"const": true}}
      }
    },
    {
      "if": {
        "properties": {
          "decision_state": {
            "enum": ["blocked", "split_required", "human_gate"]
          }
        },
        "required": ["decision_state"]
      },
      "then": {
        "properties": {
          "allowed": {"const": false},
          "runtime_state": {
            "properties": {
              "state": {"const": "not_run"},
              "child_handle": {"const": null}
            },
            "required": ["state", "child_handle"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_codes": {
            "contains": {"const": "blocked_missing_request_input"}
          }
        },
        "required": ["reason_codes"]
      },
      "then": {
        "properties": {"lane": {"const": null}}
      }
    },
    {
      "if": {
        "properties": {
          "binding": {
            "properties": {"inspected": {"const": false}},
            "required": ["inspected"]
          }
        },
        "required": ["binding"]
      },
      "then": {
        "properties": {
          "binding": {
            "properties": {"available": {"const": null}},
            "required": ["available"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "binding": {
            "properties": {
              "inspected": {"const": true},
              "available": {"const": false}
            },
            "required": ["inspected", "available"]
          }
        },
        "required": ["binding"]
      },
      "then": {
        "properties": {
          "binding": {
            "properties": {
              "reason": {"type": "string", "minLength": 1}
            },
            "required": ["reason"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime_state": {
            "properties": {
              "state": {"enum": ["decided", "not_run"]}
            },
            "required": ["state"]
          }
        },
        "required": ["runtime_state"]
      },
      "then": {
        "properties": {
          "runtime_state": {
            "properties": {"child_handle": {"const": null}},
            "required": ["child_handle"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "binding": {
            "properties": {"inspected": {"const": true}},
            "required": ["inspected"]
          }
        },
        "required": ["binding"]
      },
      "then": {
        "properties": {
          "binding": {
            "properties": {"available": {"type": "boolean"}},
            "required": ["available"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime_state": {
            "properties": {
              "state": {
                "enum": ["launched", "running", "returned", "accepted"]
              }
            },
            "required": ["state"]
          }
        },
        "required": ["runtime_state"]
      },
      "then": {
        "properties": {
          "binding": {
            "properties": {
              "interface": {"type": "string", "minLength": 1},
              "inspected": {"const": true},
              "available": {"const": true}
            },
            "required": ["interface", "inspected", "available"]
          },
          "runtime_state": {
            "properties": {
              "child_handle": {"type": "string", "minLength": 1}
            },
            "required": ["child_handle"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime_state": {
            "properties": {"state": {"const": "accepted"}},
            "required": ["state"]
          }
        },
        "required": ["runtime_state"]
      },
      "then": {
        "properties": {
          "return_validation": {
            "properties": {
              "received_outputs": {"type": "array", "minItems": 1},
              "accepted": {"const": true}
            },
            "required": ["received_outputs", "accepted"]
          },
          "closeout_handoff": {
            "properties": {
              "parent_owner": {"type": "string", "minLength": 1},
              "next_route": {"type": "string", "minLength": 1}
            },
            "required": ["parent_owner", "next_route"]
          }
        }
      }
    }
  ],
  "properties": {
    "allowed": {"type": "boolean"},
    "lane": {
      "type": ["string", "null"],
      "enum": [
        "codex_local_leaf",
        "codex_local_reviewed",
        "remote_reviewed",
        "split_required",
        "human_gate",
        null
      ]
    },
    "execution_surface": {"type": ["string", "null"]},
    "cohort_pattern": {"type": ["string", "null"]},
    "closeout_required": {"type": "boolean"},
    "decision_state": {
      "type": "string",
      "enum": ["allowed", "blocked", "split_required", "human_gate"]
    },
    "binding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["interface", "inspected", "available", "reason"],
      "properties": {
        "interface": {"type": ["string", "null"]},
        "inspected": {"type": "boolean"},
        "available": {"type": ["boolean", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "runtime_state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["state", "child_handle"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "decided",
            "not_run",
            "launched",
            "running",
            "returned",
            "accepted",
            "failed"
          ]
        },
        "child_handle": {"type": ["string", "null"]}
      }
    },
    "return_validation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["expected_outputs", "received_outputs", "accepted"],
      "properties": {
        "expected_outputs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "received_outputs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "accepted": {"type": "boolean"}
      }
    },
    "closeout_handoff": {
      "type": "object",
      "additionalProperties": true,
      "required": ["parent_owner", "residual_risk", "next_route"],
      "properties": {
        "parent_owner": {"type": ["string", "null"]},
        "residual_risk": {"type": ["string", "null"]},
        "next_route": {"type": ["string", "null"]}
      }
    },
    "actual_effects": {
      "type": "array",
      "items": {"type": "string"}
    },
    "stop_line": {"type": "string", "minLength": 1},
    "checkpoint_required": {"type": "boolean"},
    "progression_required": {"type": "boolean"},
    "requested_posture": {"type": ["string", "null"]},
    "reason_codes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "blocked_actions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "expected_outputs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "codex_local_target": {"type": ["object", "null"]},
    "return_plan": {"type": ["object", "null"]},
    "checkpoint_bridge_plan": {"type": ["object", "null"]},
    "return_receipt_plan": {"type": ["object", "null"]},
    "memo_export_plan": {"type": ["object", "null"]},
    "owner_publication_plan": {
      "type": "array",
      "items": {"type": "object"}
    }
  }
}
