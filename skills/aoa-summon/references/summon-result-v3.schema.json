{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aoa-summon/result-v3.schema.json",
  "title": "aoa-summon result v3",
  "type": "object",
  "additionalProperties": true,
  "not": {"required": ["expected_outputs"]},
  "required": [
    "allowed",
    "lane",
    "execution_surface",
    "cohort_pattern",
    "closeout_required",
    "decision_state",
    "binding",
    "runtime_state",
    "return_validation",
    "closeout_handoff",
    "actual_effects",
    "stop_line",
    "request_ref",
    "request_digest",
    "request_intent"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"request_intent": {"const": "decide"}},
        "required": ["request_intent"]
      },
      "then": {
        "properties": {
          "runtime_state": {
            "properties": {"state": {"enum": ["decided", "not_run"]}},
            "required": ["state"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_intent": {"const": "execute"},
          "allowed": {"const": true}
        },
        "required": ["request_intent", "allowed"]
      },
      "then": {
        "properties": {
          "runtime_state": {
            "properties": {
              "state": {
                "enum": ["launched", "running", "returned", "accepted", "failed"]
              }
            },
            "required": ["state"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"lane": {"const": null}},
        "required": ["lane"]
      },
      "then": {
        "properties": {
          "allowed": {"const": false},
          "decision_state": {"const": "blocked"},
          "reason_codes": {
            "contains": {"const": "blocked_missing_request_input"}
          },
          "runtime_state": {
            "properties": {
              "state": {"const": "not_run"},
              "child_handle": {"const": null}
            },
            "required": ["state", "child_handle"]
          },
          "execution_surface": {"const": null},
          "cohort_pattern": {"const": null},
          "return_validation": {
            "properties": {
              "output_checks": {"maxProperties": 0},
              "accepted": {"const": false}
            },
            "required": ["output_checks", "accepted"]
          },
          "actual_effects": {"maxItems": 0}
        },
        "required": ["reason_codes"]
      }
    },
    {
      "if": {
        "properties": {
          "runtime_state": {
            "properties": {"state": {"const": "not_run"}},
            "required": ["state"]
          }
        },
        "required": ["runtime_state"]
      },
      "then": {
        "properties": {"allowed": {"const": false}}
      }
    },
    {
      "if": {
        "properties": {"allowed": {"const": true}},
        "required": ["allowed"]
      },
      "then": {
        "properties": {
          "decision_state": {"const": "allowed"},
          "closeout_required": {"const": true},
          "lane": {
            "enum": [
              "codex_local_leaf",
              "codex_local_reviewed",
              "remote_reviewed",
              "external_cli_reviewed"
            ]
          },
          "execution_surface": {"type": "string", "minLength": 1},
          "cohort_pattern": {"type": "string", "minLength": 1},
          "runtime_state": {
            "properties": {
              "state": {
                "enum": [
                  "decided",
                  "launched",
                  "running",
                  "returned",
                  "accepted",
                  "failed"
                ]
              }
            },
            "required": ["state"]
          },
          "return_validation": {
            "properties": {
              "output_checks": {"minProperties": 1}
            },
            "required": ["output_checks"]
          },
          "closeout_handoff": {
            "properties": {
              "parent_owner": {"type": "string", "minLength": 1},
              "next_route": {"type": "string", "minLength": 1}
            },
            "required": ["parent_owner", "next_route"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"decision_state": {"const": "allowed"}},
        "required": ["decision_state"]
      },
      "then": {
        "properties": {"allowed": {"const": true}}
      }
    },
    {
      "if": {
        "properties": {
          "decision_state": {
            "enum": ["blocked", "split_required", "human_gate"]
          }
        },
        "required": ["decision_state"]
      },
      "then": {
        "properties": {
          "allowed": {"const": false},
          "runtime_state": {
            "properties": {
              "state": {"const": "not_run"},
              "child_handle": {"const": null}
            },
            "required": ["state", "child_handle"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_state": {
            "enum": ["split_required", "human_gate"]
          }
        },
        "required": ["decision_state"]
      },
      "then": {
        "properties": {
          "execution_surface": {"const": null},
          "cohort_pattern": {"const": null}
        }
      }
    },
    {
      "if": {
        "properties": {"decision_state": {"const": "split_required"}},
        "required": ["decision_state"]
      },
      "then": {
        "properties": {"lane": {"const": "split_required"}},
        "required": ["lane"]
      }
    },
    {
      "if": {
        "properties": {"lane": {"const": "split_required"}},
        "required": ["lane"]
      },
      "then": {
        "properties": {"decision_state": {"const": "split_required"}},
        "required": ["decision_state"]
      }
    },
    {
      "if": {
        "properties": {"decision_state": {"const": "human_gate"}},
        "required": ["decision_state"]
      },
      "then": {
        "properties": {"lane": {"const": "human_gate"}},
        "required": ["lane"]
      }
    },
    {
      "if": {
        "properties": {"lane": {"const": "human_gate"}},
        "required": ["lane"]
      },
      "then": {
        "properties": {"decision_state": {"const": "human_gate"}},
        "required": ["decision_state"]
      }
    },
    {
      "if": {
        "properties": {
          "reason_codes": {
            "contains": {"const": "blocked_missing_request_input"}
          }
        },
        "required": ["reason_codes"]
      },
      "then": {
        "properties": {"lane": {"const": null}}
      }
    },
    {
      "if": {
        "properties": {
          "binding": {
            "properties": {"inspected": {"const": false}},
            "required": ["inspected"]
          }
        },
        "required": ["binding"]
      },
      "then": {
        "properties": {
          "binding": {
            "properties": {"available": {"const": null}},
            "required": ["available"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "binding": {
            "properties": {
              "inspected": {"const": true},
              "available": {"const": true}
            },
            "required": ["inspected", "available"]
          }
        },
        "required": ["binding"]
      },
      "then": {
        "properties": {
          "binding": {
            "properties": {
              "interface": {"type": "string", "minLength": 1},
              "reason": {"const": null}
            },
            "required": ["interface", "reason"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "binding": {
            "properties": {
              "inspected": {"const": true},
              "available": {"const": false}
            },
            "required": ["inspected", "available"]
          }
        },
        "required": ["binding"]
      },
      "then": {
        "properties": {
          "binding": {
            "properties": {
              "reason": {"type": "string", "minLength": 1}
            },
            "required": ["reason"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime_state": {
            "properties": {
              "state": {"const": "not_run"}
            },
            "required": ["state"]
          }
        },
        "required": ["runtime_state"]
      },
      "then": {
        "properties": {
          "runtime_state": {
            "properties": {"child_handle": {"const": null}},
            "required": ["child_handle"]
          },
          "return_validation": {
            "properties": {
              "output_checks": {"maxProperties": 0},
              "accepted": {"const": false}
            },
            "required": ["output_checks", "accepted"]
          },
          "actual_effects": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime_state": {
            "properties": {"state": {"const": "decided"}},
            "required": ["state"]
          }
        },
        "required": ["runtime_state"]
      },
      "then": {
        "properties": {
          "runtime_state": {
            "properties": {"child_handle": {"const": null}},
            "required": ["child_handle"]
          },
          "return_validation": {
            "properties": {
              "output_checks": {
                "minProperties": 1,
                "additionalProperties": {
                  "properties": {
                    "received": {"const": false},
                    "artifact_ref": {"const": null},
                    "accepted": {"const": false}
                  },
                  "required": ["received", "artifact_ref", "accepted"]
                }
              },
              "accepted": {"const": false}
            },
            "required": ["output_checks", "accepted"]
          },
          "actual_effects": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "return_validation": {
            "properties": {"accepted": {"const": true}},
            "required": ["accepted"]
          }
        },
        "required": ["return_validation"]
      },
      "then": {
        "properties": {
          "runtime_state": {
            "properties": {"state": {"const": "accepted"}},
            "required": ["state"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "binding": {
            "properties": {"inspected": {"const": true}},
            "required": ["inspected"]
          }
        },
        "required": ["binding"]
      },
      "then": {
        "properties": {
          "binding": {
            "properties": {"available": {"type": "boolean"}},
            "required": ["available"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "enum": [
              "codex_local_leaf",
              "codex_local_reviewed",
              "remote_reviewed"
            ]
          },
          "runtime_state": {
            "properties": {
              "state": {
                "enum": ["launched", "running", "returned", "accepted", "failed"]
              }
            },
            "required": ["state"]
          }
        },
        "required": ["lane", "runtime_state"]
      },
      "then": {
        "properties": {
          "binding": {
            "properties": {
              "interface": {"type": "string", "minLength": 1},
              "inspected": {"const": true},
              "available": {"const": true}
            },
            "required": ["interface", "inspected", "available"]
          },
          "runtime_state": {
            "properties": {
              "child_handle": {"type": "string", "minLength": 1}
            },
            "required": ["child_handle"]
          },
          "actual_effects": {
            "minItems": 1,
            "contains": {"const": "child-agent-runtime"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"lane": {"const": "external_cli_reviewed"}},
        "required": ["lane"]
      },
      "then": {
        "properties": {
          "binding": {
            "properties": {
              "binding_kind": {"const": "external_cli_incarnation"},
              "runtime_owner": {"const": "abyss-stack"},
              "incarnation_binding_ref": {"$ref": "#/$defs/incarnationBindingRef"},
              "sdk_summon_request_ref": {"$ref": "#/$defs/sdkSummonRequestRef"},
              "sdk_summon_decision_ref": {"$ref": "#/$defs/sdkSummonDecisionRef"},
              "runtime_profile_ref": {"$ref": "#/$defs/runtimeProfileRef"},
              "uses_builtin_codex_subagents": {"const": false}
            },
            "required": [
              "binding_kind",
              "runtime_owner",
              "incarnation_binding_ref",
              "sdk_summon_request_ref",
              "sdk_summon_decision_ref",
              "runtime_profile_ref",
              "uses_builtin_codex_subagents"
            ]
          },
          "runtime_state": {
            "properties": {
              "actor_handle": {"type": "string", "minLength": 1},
              "process_handle": {"type": "string", "minLength": 1},
              "session_handle": {"type": "string", "minLength": 1},
              "continuation_handle": {"type": "string", "minLength": 1},
              "runtime_result_ref": {"$ref": "#/$defs/runtimeResultRef"},
              "runtime_a2a_return_ref": {"$ref": "#/$defs/runtimeA2AReturnRef"},
              "usage_observation_ref": {"$ref": "#/$defs/usageObservationRef"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {"const": "external_cli_reviewed"},
          "runtime_state": {
            "properties": {
              "state": {
                "enum": ["launched", "running", "returned", "accepted", "failed"]
              }
            },
            "required": ["state"]
          }
        },
        "required": ["lane", "runtime_state"]
      },
      "then": {
        "properties": {
          "binding": {
            "properties": {
              "interface": {"type": "string", "minLength": 1},
              "inspected": {"const": true},
              "available": {"const": true}
            },
            "required": ["interface", "inspected", "available"]
          },
          "runtime_state": {
            "required": [
              "actor_handle",
              "process_handle",
              "session_handle",
              "continuation_handle"
            ]
          },
          "actual_effects": {"contains": {"const": "external-actor-runtime"}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {"const": "external_cli_reviewed"},
          "runtime_state": {
            "properties": {"state": {"enum": ["returned", "accepted"]}},
            "required": ["state"]
          }
        },
        "required": ["lane", "runtime_state"]
      },
      "then": {
        "properties": {
          "runtime_state": {
            "required": [
              "runtime_result_ref",
              "runtime_a2a_return_ref",
              "usage_observation_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {"const": "external_cli_reviewed"},
          "runtime_state": {
            "properties": {"state": {"const": "failed"}},
            "required": ["state"]
          }
        },
        "required": ["lane", "runtime_state"]
      },
      "then": {
        "properties": {
          "runtime_state": {
            "required": ["runtime_result_ref", "usage_observation_ref"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime_state": {
            "properties": {
              "state": {"enum": ["launched", "running"]}
            },
            "required": ["state"]
          }
        },
        "required": ["runtime_state"]
      },
      "then": {
        "properties": {
          "return_validation": {
            "properties": {
              "output_checks": {
                "minProperties": 1,
                "additionalProperties": {
                  "properties": {
                    "received": {"const": false},
                    "artifact_ref": {"const": null},
                    "accepted": {"const": false}
                  },
                  "required": ["received", "artifact_ref", "accepted"]
                }
              },
              "accepted": {"const": false}
            },
            "required": ["output_checks", "accepted"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime_state": {
            "properties": {"state": {"const": "accepted"}},
            "required": ["state"]
          }
        },
        "required": ["runtime_state"]
      },
      "then": {
        "properties": {
          "return_validation": {
            "properties": {
              "output_checks": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "properties": {
                    "received": {"const": true},
                    "artifact_ref": {"type": "string", "minLength": 1},
                    "accepted": {"const": true}
                  },
                  "required": ["received", "artifact_ref", "accepted"]
                }
              },
              "accepted": {"const": true}
            },
            "required": ["output_checks", "accepted"]
          },
          "closeout_handoff": {
            "properties": {
              "parent_owner": {"type": "string", "minLength": 1},
              "next_route": {"type": "string", "minLength": 1}
            },
            "required": ["parent_owner", "next_route"]
          }
        }
      }
    }
  ],
  "properties": {
    "allowed": {"type": "boolean"},
    "lane": {
      "type": ["string", "null"],
      "enum": [
        "codex_local_leaf",
        "codex_local_reviewed",
        "remote_reviewed",
        "external_cli_reviewed",
        "split_required",
        "human_gate",
        null
      ]
    },
    "execution_surface": {"type": ["string", "null"]},
    "cohort_pattern": {"type": ["string", "null"]},
    "closeout_required": {"type": "boolean"},
    "decision_state": {
      "type": "string",
      "enum": ["allowed", "blocked", "split_required", "human_gate"]
    },
    "binding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["interface", "inspected", "available", "reason"],
      "properties": {
        "interface": {"type": ["string", "null"]},
        "inspected": {"type": "boolean"},
        "available": {"type": ["boolean", "null"]},
        "reason": {"type": ["string", "null"]},
        "binding_kind": {
          "type": ["string", "null"],
          "enum": ["codex_builtin_child", "remote_endpoint", "external_cli_incarnation", null]
        },
        "runtime_owner": {"type": ["string", "null"]},
        "incarnation_binding_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/contentRef"}]
        },
        "sdk_summon_request_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/contentRef"}]
        },
        "sdk_summon_decision_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/contentRef"}]
        },
        "runtime_profile_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/contentRef"}]
        },
        "uses_builtin_codex_subagents": {"type": ["boolean", "null"]}
      }
    },
    "runtime_state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "decided",
            "not_run",
            "launched",
            "running",
            "returned",
            "accepted",
            "failed"
          ]
        },
        "child_handle": {"type": ["string", "null"]},
        "actor_handle": {"type": ["string", "null"]},
        "process_handle": {"type": ["string", "null"]},
        "session_handle": {"type": ["string", "null"]},
        "continuation_handle": {"type": ["string", "null"]},
        "runtime_result_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/contentRef"}]
        },
        "runtime_a2a_return_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/contentRef"}]
        },
        "usage_observation_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/contentRef"}]
        }
      }
    },
    "return_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_checks", "accepted"],
      "properties": {
        "output_checks": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "received",
              "artifact_ref",
              "accepted"
            ],
            "properties": {
              "received": {"type": "boolean"},
              "artifact_ref": {"type": ["string", "null"]},
              "accepted": {"type": "boolean"}
            },
            "allOf": [
              {
                "if": {
                  "properties": {"received": {"const": false}},
                  "required": ["received"]
                },
                "then": {
                  "properties": {
                    "artifact_ref": {"const": null},
                    "accepted": {"const": false}
                  }
                }
              },
              {
                "if": {
                  "properties": {"accepted": {"const": true}},
                  "required": ["accepted"]
                },
                "then": {
                  "properties": {
                    "received": {"const": true},
                    "artifact_ref": {"type": "string", "minLength": 1}
                  }
                }
              }
            ]
          }
        },
        "accepted": {"type": "boolean"}
      }
    },
    "closeout_handoff": {
      "type": "object",
      "additionalProperties": true,
      "required": ["parent_owner", "residual_risk", "next_route"],
      "properties": {
        "parent_owner": {"type": ["string", "null"]},
        "residual_risk": {"type": ["string", "null"]},
        "next_route": {"type": ["string", "null"]}
      }
    },
    "actual_effects": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "stop_line": {"type": "string", "minLength": 1},
    "request_ref": {"type": "string", "minLength": 1},
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request_intent": {
      "type": "string",
      "enum": ["decide", "execute"]
    },
    "checkpoint_required": {"type": "boolean"},
    "progression_required": {"type": "boolean"},
    "requested_posture": {"type": ["string", "null"]},
    "reason_codes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "blocked_actions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "codex_local_target": {"type": ["object", "null"]},
    "return_plan": {"type": ["object", "null"]},
    "checkpoint_bridge_plan": {"type": ["object", "null"]},
    "return_receipt_plan": {"type": ["object", "null"]},
    "memo_export_plan": {"type": ["object", "null"]},
    "owner_publication_plan": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "$defs": {
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "owner_repo", "schema_version", "digest"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "owner_repo": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "incarnationBindingRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "aoa-sdk"}, "schema_version": {"const": "aoa_agent_incarnation_binding_v1"}}}
      ]
    },
    "sdkSummonRequestRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "aoa-sdk"}, "schema_version": {"const": "urn:aoa-sdk:a2a:summon-request:v4"}}}
      ]
    },
    "sdkSummonDecisionRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "aoa-sdk"}, "schema_version": {"const": "urn:aoa-sdk:a2a:summon-result:v4"}}}
      ]
    },
    "runtimeProfileRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "abyss-stack"}, "schema_version": {"const": "abyss_stack_external_codex_runtime_profile_v1"}}}
      ]
    },
    "runtimeResultRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "abyss-stack"}, "schema_version": {"const": "abyss_stack_external_codex_result_v1"}}}
      ]
    },
    "runtimeA2AReturnRef": {
