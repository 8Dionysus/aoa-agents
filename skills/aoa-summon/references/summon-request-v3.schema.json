{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aoa-summon/request-v3.schema.json",
  "title": "aoa-summon request v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quest_passport",
    "summon_request",
    "expected_outputs",
    "intent",
    "return_owner",
    "child_scope",
    "child_stop_line",
    "child_inputs",
    "request_ref",
    "request_digest"
  ],
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "quest_passport": {
              "required": ["route_anchor"],
              "properties": {
                "route_anchor": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        {
          "properties": {
            "summon_request": {
              "required": ["parent_task_id"],
              "properties": {
                "parent_task_id": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        {
          "properties": {
            "summon_request": {
              "required": ["session_ref"],
              "properties": {
                "session_ref": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "summon_request": {
            "properties": {"transport_preference": {"const": "external_cli"}},
            "required": ["transport_preference"]
          }
        },
        "required": ["summon_request"]
      },
      "then": {
        "required": ["external_incarnation"],
        "properties": {
          "external_incarnation": {
            "properties": {
              "launches_separate_os_process": {"const": true},
              "uses_builtin_codex_subagents": {"const": false},
              "separate_cli_session": {"const": true},
              "usage_metering": {"const": "observe_only_no_budget"}
            }
          }
        }
      }
    }
  ],
  "properties": {
    "quest_passport": {
      "type": "object",
      "additionalProperties": true,
      "required": ["difficulty", "risk", "control_mode", "delegate_tier"],
      "properties": {
        "difficulty": {"type": "string"},
        "risk": {"type": "string"},
        "control_mode": {"type": "string"},
        "delegate_tier": {"type": "string"},
        "fallback_tier": {"type": ["string", "null"]},
        "wrapper_class": {"type": ["string", "null"]},
        "route_anchor": {"type": ["string", "null"]},
        "expected_artifacts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "self_agent": {"type": "boolean"}
      }
    },
    "summon_request": {
      "type": "object",
      "additionalProperties": true,
      "not": {"required": ["expected_outputs"]},
      "properties": {
        "desired_role": {"type": ["string", "null"]},
        "child_agent_id": {"type": ["string", "null"]},
        "transport_preference": {
          "type": "string",
          "enum": ["codex_local", "a2a_remote", "external_cli", "either"]
        },
        "parent_task_id": {"type": ["string", "null"]},
        "session_ref": {"type": ["string", "null"]},
        "reviewed_artifact_path": {"type": ["string", "null"]},
        "require_progression": {"type": "boolean"}
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "intent": {
      "type": "string",
      "enum": ["decide", "execute"]
    },
    "request_ref": {
      "type": "string",
      "minLength": 1
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "return_owner": {
      "type": "string",
      "minLength": 1
    },
    "child_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "allowed_tools", "allowed_effects", "authority_limit"],
      "properties": {
        "task": {"type": "string", "minLength": 1},
        "allowed_tools": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "allowed_effects": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "authority_limit": {"type": "string", "minLength": 1}
      }
    },
    "child_stop_line": {
      "type": "string",
      "minLength": 1
    },
    "child_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["artifact", "context", "contract", "evidence", "source", "other"]
          },
          "ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "external_incarnation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_ref",
        "actor_mandate_ref",
        "task_local_dag_ref",
        "incarnation_binding_ref",
        "sdk_summon_request_ref",
        "sdk_summon_decision_ref",
        "runtime_launch_ref",
        "runtime_interface",
        "responsibility_from",
        "responsibility_to",
        "domain_procedure_refs",
        "continuity_ref",
        "return_event_schema_ref",
        "launches_separate_os_process",
        "uses_builtin_codex_subagents",
        "separate_cli_session",
        "usage_metering"
      ],
      "properties": {
        "obligation_ref": {"$ref": "#/$defs/agentObligationRef"},
        "actor_mandate_ref": {"$ref": "#/$defs/actorMandateRef"},
        "task_local_dag_ref": {"$ref": "#/$defs/taskLocalDagRef"},
        "incarnation_binding_ref": {"$ref": "#/$defs/incarnationBindingRef"},
        "sdk_summon_request_ref": {"$ref": "#/$defs/sdkSummonRequestRef"},
        "sdk_summon_decision_ref": {"$ref": "#/$defs/sdkSummonDecisionRef"},
        "runtime_launch_ref": {"$ref": "#/$defs/runtimeLaunchRef"},
        "runtime_interface": {"type": "string", "minLength": 1},
        "responsibility_from": {"type": "string", "minLength": 1},
        "responsibility_to": {"type": "string", "minLength": 1},
        "domain_procedure_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/contentRef"}
        },
        "continuity_ref": {"$ref": "#/$defs/sdkContinuityRef"},
        "return_event_schema_ref": {"$ref": "#/$defs/runtimeEventRef"},
        "launches_separate_os_process": {"type": "boolean"},
        "uses_builtin_codex_subagents": {"type": "boolean"},
        "separate_cli_session": {"type": "boolean"},
        "usage_metering": {"type": "string", "enum": ["observe_only_no_budget"]}
      }
    },
    "progression_overlay_ref": {"type": ["string", "null"]},
    "self_agent_checkpoint_ref": {"type": ["string", "null"]},
    "stress_bundle_ref": {"type": ["string", "null"]},
    "checkpoint_note_ref": {"type": ["string", "null"]},
    "codex_trace_ref": {"type": ["string", "null"]},
    "reviewed_artifact_path": {"type": ["string", "null"]},
    "audit_refs": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "owner_repo", "schema_version", "digest"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "owner_repo": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "agentObligationRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "aoa-agents"}, "schema_version": {"const": "agent-obligation-v1"}}}
      ]
    },
    "actorMandateRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "aoa-agents"}, "schema_version": {"const": "actor-mandate-v1"}}}
      ]
    },
    "taskLocalDagRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "aoa-skills"}, "schema_version": {"const": "aoa-task-local-dag-v2"}}}
      ]
    },
    "incarnationBindingRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "aoa-sdk"}, "schema_version": {"const": "aoa_agent_incarnation_binding_v1"}}}
      ]
    },
    "sdkSummonRequestRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "aoa-sdk"}, "schema_version": {"const": "urn:aoa-sdk:a2a:summon-request:v4"}}}
      ]
    },
    "sdkSummonDecisionRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "aoa-sdk"}, "schema_version": {"const": "urn:aoa-sdk:a2a:summon-result:v4"}}}
      ]
    },
    "runtimeLaunchRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "abyss-stack"}, "schema_version": {"const": "abyss_stack_external_codex_launch_v1"}}}
      ]
    },
    "sdkContinuityRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "aoa-sdk"}}}
      ]
    },
    "runtimeEventRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"owner_repo": {"const": "abyss-stack"}, "schema_version": {"const": "abyss_stack_external_codex_event_v1"}}}
      ]
    }
  }
}
